/* ===========================================================================
   LocalDocsAI — dark slate base + amber citations + cyan AI accent
   Translated from the LocalDocsAI Prototype design (OKLCH → hex).
   =========================================================================== */

/* --- Color tokens (referenced by name in comments) ---------------------------
   --bg          : #15171c   very dark slate
   --bg-elev     : #1a1d23
   --bg-elev-2   : #1f2329
   --panel       : #181b20
   --border      : #2b2f37
   --border-strong: #3a3f49
   --text        : #ecedf0
   --text-soft   : #b8bbc1
   --text-muted  : #828690
   --text-dim    : #5f636d
   --accent      : #4ec2e8   (cyan-blue, AI)
   --accent-soft : rgba(78,194,232,0.14)
   --accent-line : rgba(78,194,232,0.35)
   --cite        : #dcae4a   (amber, citations)
   --cite-soft   : rgba(220,174,74,0.14)
   --cite-line   : rgba(220,174,74,0.40)
   --ok          : #5dc488
   --warn        : #e6b34c
   --danger      : #e36a52
   --------------------------------------------------------------------------- */

/* ===== GLOBAL ===== */
QWidget {
    background-color: #15171c;
    color: #ecedf0;
    font-family: "Geist", "Segoe UI", "Inter", "Helvetica Neue", Arial, sans-serif;
    font-size: 13px;
}
QToolTip {
    background-color: #1f2329;
    color: #ecedf0;
    border: 1px solid #3a3f49;
    border-radius: 6px;
    padding: 4px 8px;
}

/* ===== MAIN WINDOW ===== */
QMainWindow {
    background-color: #15171c;
}
QMainWindow::separator {
    background-color: #2b2f37;
    width: 1px;
    height: 1px;
}

/* ===== SCROLLBARS ===== */
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: #2b2f37;
    border-radius: 5px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover {
    background: #3a3f49;
}
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: transparent;
    border: none;
    height: 0;
}
QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 0;
}
QScrollBar::handle:horizontal {
    background: #2b2f37;
    border-radius: 5px;
    min-width: 30px;
}
QScrollBar::handle:horizontal:hover { background: #3a3f49; }
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal,
QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal { background: transparent; border: none; width: 0; }

/* ===========================================================================
   SIDEBAR
   =========================================================================== */
#sidebar {
    background-color: #181b20;
    border-right: 1px solid #2b2f37;
}
#sidebarHeader {
    background-color: transparent;
    border-bottom: 1px solid #2b2f37;
    padding: 4px 0;
}
#brandWrap {
    background-color: transparent;
}
#brandMark {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #6cd3f0,
        stop:0.6 #2f86b3,
        stop:1 #1b4d6c);
    border: 1px solid rgba(255, 255, 255, 30);
    border-radius: 8px;
}
#logoLabel {
    color: #ecedf0;
    font-size: 14.5px;
    font-weight: 600;
    letter-spacing: -0.2px;
    background-color: transparent;
}
#brandSub {
    color: #5f636d;
    font-size: 10px;
    letter-spacing: 1.4px;
    background-color: transparent;
}
#newChatWrap { background-color: transparent; }
#newChatBtn {
    background-color: #1a1d23;
    color: #ecedf0;
    border: 1px solid #3a3f49;
    border-radius: 10px;
    padding: 8px 12px;
    font-size: 13px;
    font-weight: 500;
}
#newChatBtn:hover {
    background-color: #1f2329;
    border-color: #4a4f59;
}
#collapseBtn {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 7px;
}
#collapseBtn:hover {
    background-color: #1f2329;
}

/* Section header label */
#sectionLabel {
    color: #5f636d;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 1px;
    padding: 14px 16px 6px 16px;
    background-color: transparent;
}

/* Chat list */
#chatListWidget {
    background-color: transparent;
    border: none;
    padding: 2px 6px;
    outline: 0;
}
#chatListWidget::item {
    background-color: transparent;
    color: #b8bbc1;
    border-radius: 7px;
    padding: 0;
    margin: 1px 0;
}
#chatListWidget::item:hover {
    background-color: #1a1d23;
}
#chatListWidget::item:selected {
    background-color: #1f2329;
    color: #ecedf0;
}

/* Custom chat row (title + delete button) */
#chatRow {
    background-color: transparent;
}
#chatRowTitle {
    background-color: transparent;
    color: #b8bbc1;
    font-size: 13px;
}
#chatListWidget::item:selected #chatRowTitle {
    color: #ecedf0;
}
#chatListWidget::item:hover #chatRowTitle {
    color: #ecedf0;
}
#chatDeleteBtn {
    background-color: transparent;
    border: none;
    border-radius: 5px;
    padding: 0;
}
#chatDeleteBtn:hover {
    background-color: rgba(227, 106, 82, 50);
}
#chatDeleteBtn:pressed {
    background-color: rgba(227, 106, 82, 90);
}

/* Streaming indicator dot — alternates 'on' state via QTimer in _ChatRow */
#chatRowStreamingDot {
    background-color: rgba(78, 194, 232, 60);
    border-radius: 4px;
    min-width: 8px;
    max-width: 8px;
    min-height: 8px;
    max-height: 8px;
}
#chatRowStreamingDot[on="true"] {
    background-color: #4ec2e8;
}

/* Sidebar footer */
#sidebarFooter {
    background-color: #181b20;
    border-top: 1px solid #2b2f37;
    padding: 8px 0;
}
#footerBtn {
    background-color: transparent;
    color: #828690;
    border: none;
    border-radius: 7px;
    padding: 7px 10px;
    text-align: left;
    font-size: 13px;
}
#footerBtn:hover {
    background-color: #1a1d23;
    color: #ecedf0;
}
#modelStatusRow {
    background-color: #1a1d23;
    border: 1px solid #2b2f37;
    border-radius: 8px;
}
#statusDot {
    background-color: #5dc488;
    border-radius: 3px;
    min-width: 7px;
    max-width: 7px;
    min-height: 7px;
    max-height: 7px;
}
#statusLabel {
    color: #828690;
    font-size: 11px;
    background-color: transparent;
    letter-spacing: 0.2px;
}
#modelStatusLabel {
    color: #ecedf0;
    font-size: 11px;
    background-color: transparent;
}

/* ===========================================================================
   TOPBAR
   =========================================================================== */
#topbar {
    background-color: #15171c;
    border-bottom: 1px solid #2b2f37;
    min-height: 56px;
    max-height: 56px;
    padding: 0 20px;
}
#topbarTitleWrap {
    background-color: transparent;
}
#chatTitleLabel {
    color: #ecedf0;
    font-size: 14px;
    font-weight: 600;
    background-color: transparent;
    letter-spacing: -0.1px;
}
#topbarMeta {
    background-color: transparent;
    color: #5f636d;
    font-size: 10.5px;
    letter-spacing: 0.4px;
}
#topbarSep {
    color: #2b2f37;
    background-color: #2b2f37;
    max-width: 1px;
    margin: 12px 4px;
}
#scopeBtn {
    background-color: #1a1d23;
    color: #ecedf0;
    border: 1px solid #2b2f37;
    border-radius: 8px;
    padding: 6px 12px;
    font-size: 12px;
}
#scopeBtn:hover {
    background-color: #1f2329;
    border-color: #3a3f49;
}
#topbarActionBtn {
    background-color: transparent;
    color: #b8bbc1;
    border: 1px solid transparent;
    border-radius: 8px;
    padding: 6px 12px;
    font-size: 12.5px;
}
#topbarActionBtn:hover {
    background-color: #1a1d23;
    color: #ecedf0;
}
#topbarActionBtn:checked {
    background-color: rgba(78, 194, 232, 36);
    color: #4ec2e8;
    border-color: rgba(78, 194, 232, 90);
}

/* ===========================================================================
   CHAT AREA
   =========================================================================== */
#chatScrollArea {
    background-color: #15171c;
    border: none;
}
#chatContent {
    background-color: #15171c;
}
#chatCenterCol {
    background-color: transparent;
}

/* Message separators between turns */
#messageSeparator {
    background-color: #2b2f37;
    max-height: 1px;
    min-height: 1px;
    border: none;
}

/* User messages: right-aligned, elevated bubble */
#userMessageWidget {
    background-color: transparent;
}
#userBubble {
    background-color: #1f2329;
    color: #ecedf0;
    border: 1px solid #2b2f37;
    border-radius: 12px;
    padding: 12px 16px;
    font-size: 14px;
}

/* Assistant messages: flush, no bubble */
#assistantMessageWidget {
    background-color: transparent;
}
#messageText {
    background-color: transparent;
    color: #ecedf0;
    border: none;
    font-size: 14.5px;
    line-height: 1.55;
    selection-background-color: rgba(78, 194, 232, 60);
    selection-color: #ecedf0;
}

/* Pipeline trace row */
#traceWidget {
    background-color: #1a1d23;
    border: 1px solid #2b2f37;
    border-radius: 8px;
    padding: 8px 12px;
}
#traceLabel {
    background-color: transparent;
    color: #828690;
    font-size: 11.5px;
}

/* Source pills row (below assistant) */
#pillsRow {
    background-color: transparent;
}
#sourcePill {
    background-color: #1a1d23;
    color: #b8bbc1;
    border: 1px solid #2b2f37;
    border-radius: 7px;
    padding: 5px 10px;
    font-size: 11.5px;
}
#sourcePill:hover {
    background-color: #1f2329;
    border-color: rgba(220, 174, 74, 100);
    color: #ecedf0;
}

/* Suggestion cards on empty state */
#suggestionCard {
    background-color: #1a1d23;
    border: 1px solid #2b2f37;
    border-radius: 10px;
    padding: 14px 16px;
}
#suggestionCard:hover {
    background-color: #1f2329;
    border-color: #3a3f49;
}
#suggestionTitle {
    background-color: transparent;
    color: #ecedf0;
    font-size: 13px;
    font-weight: 500;
}
#suggestionSub {
    background-color: transparent;
    color: #5f636d;
    font-size: 11.5px;
}

/* Empty state */
#emptyState {
    background-color: transparent;
}
#emptyStateTitle {
    background-color: transparent;
    color: #ecedf0;
    font-size: 22px;
    font-weight: 600;
    letter-spacing: -0.4px;
}
#emptyStateSubtitle {
    background-color: transparent;
    color: #828690;
    font-size: 14px;
}

/* Streaming spinner / thinking indicator */
#streamingSpinner {
    background-color: transparent;
    color: #4ec2e8;
    font-size: 14px;
}
#streamingPhase {
    background-color: transparent;
    color: #b8bbc1;
    font-size: 13px;
}

/* ===========================================================================
   COMPOSER
   =========================================================================== */
#composerWidget {
    background-color: transparent;
}
#composerInner {
    background-color: #1a1d23;
    border: 1px solid #3a3f49;
    border-radius: 14px;
    padding: 4px;
}
#composerInner:focus-within {
    border-color: rgba(78, 194, 232, 90);
}
#composerInput {
    background-color: transparent;
    color: #ecedf0;
    border: none;
    padding: 8px 8px;
    font-size: 14px;
    selection-background-color: rgba(78, 194, 232, 60);
}
#composerInput:focus { border: none; outline: none; }

#scopeChip {
    background-color: rgba(78, 194, 232, 36);
    color: #4ec2e8;
    border: 1px solid rgba(78, 194, 232, 90);
    border-radius: 7px;
    padding: 5px 10px;
    font-size: 11.5px;
}
#scopeChip:hover {
    background-color: rgba(78, 194, 232, 55);
}

#composerActionBtn {
    background-color: transparent;
    color: #828690;
    border: none;
    border-radius: 7px;
    padding: 6px;
}
#composerActionBtn:hover {
    background-color: #1f2329;
    color: #ecedf0;
}

#sendBtn {
    background-color: rgba(78, 194, 232, 36);
    color: #4ec2e8;
    border: 1px solid rgba(78, 194, 232, 90);
    border-radius: 8px;
    padding: 6px;
    min-width: 32px;
    min-height: 32px;
}
#sendBtn:hover {
    background-color: rgba(78, 194, 232, 60);
}
#sendBtn:pressed {
    background-color: rgba(78, 194, 232, 90);
}
#sendBtn:disabled {
    color: #5f636d;
    border-color: #2b2f37;
    background-color: transparent;
}
#sendBtn[cancelling="true"] {
    background-color: rgba(227, 106, 82, 36);
    border: 1px solid rgba(227, 106, 82, 120);
    color: #e36a52;
}
#sendBtn[cancelling="true"]:hover {
    background-color: rgba(227, 106, 82, 60);
}
#sendBtn[cancelling="true"]:pressed {
    background-color: rgba(227, 106, 82, 90);
}

/* ===========================================================================
   SOURCES PANEL (right)
   =========================================================================== */
#sourcesPanel {
    background-color: #181b20;
    border-left: 1px solid #2b2f37;
}
#sourcesPanelHeader {
    background-color: transparent;
    border-bottom: 1px solid #2b2f37;
    min-height: 56px;
    max-height: 56px;
    padding: 0 16px;
}
#sourcesPanelTitle {
    background-color: transparent;
    color: #ecedf0;
    font-size: 13px;
    font-weight: 600;
}
#closePanelBtn {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 7px;
    padding: 4px;
}
#closePanelBtn:hover {
    background-color: #1f2329;
}
#sourcesGroupHeader {
    background-color: transparent;
}
#sourcesGroupLabel {
    background-color: transparent;
    color: #5f636d;
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 1px;
    padding: 8px 4px 4px 4px;
}
#sourcesGroupSep {
    background-color: #2b2f37;
    max-height: 1px;
    min-height: 1px;
}
#sourcesFooter {
    background-color: #15171c;
    border-top: 1px solid #2b2f37;
    padding: 8px 14px;
}
#footerValidationLabel {
    background-color: transparent;
    color: #5f636d;
    font-size: 10.5px;
}

/* Source card */
#sourceCard {
    background-color: #1a1d23;
    border: 1px solid #2b2f37;
    border-radius: 10px;
    padding: 12px 14px;
}
#sourceCard:hover {
    background-color: #1f2329;
    border-color: rgba(220, 174, 74, 100);
}
#sourceCardN {
    background-color: rgba(220, 174, 74, 36);
    color: #dcae4a;
    border: 1px solid rgba(220, 174, 74, 100);
    border-radius: 5px;
    font-size: 11px;
    font-weight: 600;
    min-width: 20px;
    max-width: 20px;
    min-height: 20px;
    max-height: 20px;
    qproperty-alignment: AlignCenter;
}
#sourceCardTitle {
    background-color: transparent;
    color: #ecedf0;
    font-size: 12.5px;
    font-weight: 500;
}
#sourceCardCode {
    background-color: transparent;
    color: #b8bbc1;
    font-size: 11px;
}
#sourceCardMeta {
    background-color: transparent;
    color: #5f636d;
    font-size: 10.5px;
}
#sourceCardSnippet {
    background-color: #15171c;
    color: #b8bbc1;
    border: 1px solid #2b2f37;
    border-radius: 7px;
    padding: 8px 10px;
    font-size: 12px;
}
#sourceCardChunkId {
    background-color: transparent;
    color: #5f636d;
    font-size: 10px;
}
#scoreBar {
    background-color: #15171c;
    border: 1px solid #2b2f37;
    border-radius: 3px;
    max-height: 4px;
    min-height: 4px;
}
#scoreBarFill {
    background-color: #4ec2e8;
    border-radius: 2px;
    max-height: 4px;
}

/* ===========================================================================
   DIALOGS (folder manager, settings, export)
   =========================================================================== */
QDialog {
    background-color: #181b20;
    color: #ecedf0;
}
#dialogHeader {
    background-color: transparent;
    border-bottom: 1px solid #2b2f37;
    padding: 8px 16px;
}
#dialogTitle {
    background-color: transparent;
    color: #ecedf0;
    font-size: 15px;
    font-weight: 600;
}
#closeDialogBtn {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 7px;
    padding: 4px;
}
#closeDialogBtn:hover { background-color: #1f2329; }

QTabWidget::pane {
    background-color: transparent;
    border: none;
    border-top: 1px solid #2b2f37;
}
QTabBar::tab {
    background-color: transparent;
    color: #828690;
    border: none;
    padding: 10px 16px;
    font-size: 12.5px;
}
QTabBar::tab:hover { color: #ecedf0; }
QTabBar::tab:selected {
    color: #ecedf0;
    border-bottom: 2px solid #4ec2e8;
}

/* Generic push buttons */
QPushButton {
    background-color: transparent;
    color: #b8bbc1;
    border: 1px solid transparent;
    border-radius: 8px;
    padding: 7px 12px;
    font-size: 12.5px;
}
QPushButton:hover {
    background-color: #1a1d23;
    color: #ecedf0;
}

#dangerBtn {
    background-color: transparent;
    color: #e36a52;
    border: 1px solid rgba(227, 106, 82, 80);
    border-radius: 8px;
    padding: 7px 14px;
}
#dangerBtn:hover {
    background-color: rgba(227, 106, 82, 30);
}

/* QLineEdit / QTextEdit / QComboBox inputs */
QLineEdit, QTextEdit, QPlainTextEdit, QComboBox, QSpinBox, QDoubleSpinBox {
    background-color: #15171c;
    color: #ecedf0;
    border: 1px solid #2b2f37;
    border-radius: 8px;
    padding: 8px 10px;
    selection-background-color: rgba(78, 194, 232, 60);
}
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus,
QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: rgba(78, 194, 232, 90);
}
QComboBox::drop-down {
    border: none;
    width: 20px;
}
QComboBox QAbstractItemView {
    background-color: #181b20;
    color: #ecedf0;
    border: 1px solid #2b2f37;
    selection-background-color: #1f2329;
    outline: 0;
}

/* QLabel default */
QLabel {
    background-color: transparent;
    color: #ecedf0;
}

/* Tree widget (folder manager files list) */
QTreeWidget {
    background-color: #15171c;
    color: #ecedf0;
    border: 1px solid #2b2f37;
    border-radius: 8px;
    alternate-background-color: #181b20;
    outline: 0;
}
QTreeWidget::item {
    padding: 6px 4px;
}
QTreeWidget::item:hover { background-color: #1a1d23; }
QTreeWidget::item:selected { background-color: #1f2329; color: #ecedf0; }
QHeaderView::section {
    background-color: #181b20;
    color: #828690;
    border: none;
    border-bottom: 1px solid #2b2f37;
    padding: 8px 6px;
    font-size: 11.5px;
    font-weight: 500;
}

/* Generic QListWidget (used in dialogs) */
QListWidget {
    background-color: transparent;
    color: #ecedf0;
    border: 1px solid #2b2f37;
    border-radius: 8px;
    outline: 0;
}
QListWidget::item {
    padding: 8px 12px;
    border-radius: 6px;
    margin: 1px 4px;
}
QListWidget::item:hover { background-color: #1a1d23; }
QListWidget::item:selected { background-color: #1f2329; color: #ecedf0; }

/* Indexing status & progress */
#indexingStatusLabel {
    color: #dcae4a;
    background-color: transparent;
    font-size: 12px;
    padding: 4px 0;
}
#indexingProgressBar {
    background-color: #15171c;
    border: 1px solid #2b2f37;
    border-radius: 4px;
    max-height: 16px;
    min-height: 16px;
    text-align: center;
    color: #ecedf0;
    font-size: 11px;
    font-weight: 600;
}
#indexingProgressBar::chunk {
    background-color: #4ec2e8;
    border-radius: 3px;
}

/* Generic progress bar (fallback) */
QProgressBar {
    background-color: #1a1d23;
    border: none;
    border-radius: 3px;
    max-height: 6px;
    text-align: center;
    color: transparent;
}
QProgressBar::chunk {
    background-color: #4ec2e8;
    border-radius: 3px;
}

/* QCheckBox / QRadioButton */
QCheckBox, QRadioButton {
    background-color: transparent;
    color: #ecedf0;
    spacing: 8px;
}
QCheckBox::indicator, QRadioButton::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid #3a3f49;
    background-color: #15171c;
}
QCheckBox::indicator { border-radius: 4px; }
QRadioButton::indicator { border-radius: 7px; }
QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background-color: #4ec2e8;
    border-color: #4ec2e8;
}

/* QSplitter handle */
QSplitter::handle {
    background-color: #2b2f37;
}
QSplitter::handle:horizontal { width: 1px; }
QSplitter::handle:vertical { height: 1px; }

/* QMessageBox */
QMessageBox {
    background-color: #181b20;
}
QMessageBox QLabel { color: #ecedf0; }
